<Window x:Class="GuvenliArsivGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Güvenli Arşiv Analizcisi" Height="680" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Üst Başlık ve Seçim Butonları -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" Padding="18" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Güvenli Arşiv Analizcisi" FontSize="22" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="ZIP arşivlerini diske çıkarmadan statik metadata ve güvenlik riski analizi yapın" 
                               FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSelectFile" Content="📄 ZIP Dosyası Seç" Click="BtnSelectFile_Click"
                            Padding="15,10" Margin="0,0,10,0" Background="#2563EB" Foreground="White" 
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="BtnSelectFolder" Content="📁 Klasör Tara" Click="BtnSelectFolder_Click"
                            Padding="15,10" Background="#334155" Foreground="White" 
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sürükle-Bırak ve Durum Çubuğu -->
        <Border Grid.Row="1" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="8" 
                Background="#162032" Padding="12" Margin="0,0,0,15">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Analiz için yukarıdan seçim yapın veya bir .zip dosyasını pencereye sürükleyip bırakın..." 
                           Foreground="#CBD5E1" VerticalAlignment="Center"/>
                <ProgressBar x:Name="ProgressAnalyze" Width="160" Height="10" HorizontalAlignment="Right" 
                             IsIndeterminate="True" Visibility="Collapsed" Foreground="#38BDF8" Background="#0F172A"/>
            </Grid>
        </Border>

        <!-- Ana İçerik: Sol Taraf Arşiv Listesi, Sağ Taraf Güvenlik Detayları -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Sol Panel: Analiz Edilen Arşivler Tablosu -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Analiz Sonuçları" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#E2E8F0"/>

                    <DataGrid x:Name="GridReports" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="GridReports_SelectionChanged"
                              Background="#0F172A" Foreground="#F8FAFC" RowBackground="#1E293B" 
                              AlternatingRowBackground="#172033" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#334155" BorderThickness="0" HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Arşiv Adı" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTemplateColumn Header="Risk" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" Margin="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#475569"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RiskLevel}" Value="HIGH">
                                                            <Setter Property="Background" Value="#DC2626"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RiskLevel}" Value="MEDIUM">
                                                            <Setter Property="Background" Value="#D97706"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RiskLevel}" Value="LOW">
                                                            <Setter Property="Background" Value="#16A34A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding RiskLevel}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dosya" Binding="{Binding TotalFiles}" Width="65"/>
                            <DataGridTextColumn Header="Oran" Binding="{Binding CompressionRatio, StringFormat={}{0:F2}x}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Sağ Panel: Seçili Arşivin Detaylı Güvenlik Raporu -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="10" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelDetails">
                        <TextBlock Text="Arşiv Güvenlik Detayları" FontSize="15" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,12"/>
                        <TextBlock x:Name="TxtDetailPlaceholder" Text="Detayları görmek için soldaki tablodan bir arşiv seçin." 
                                   Foreground="#64748B" TextWrapping="Wrap"/>

                        <StackPanel x:Name="PanelDetailContent" Visibility="Collapsed">
                            <TextBlock x:Name="TxtDetailTitle" FontSize="17" FontWeight="Bold" Foreground="#38BDF8" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtDetailStats" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,15"/>

                            <TextBlock Text="Tespit Edilen Uyarılar" FontWeight="SemiBold" Foreground="#F87171" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="ListWarnings" Margin="0,0,0,15">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2D1B24" CornerRadius="5" Padding="8" Margin="0,0,0,5">
                                            <TextBlock Text="{Binding}" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Teknik Bulgular" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtTechnicalFindings" IsReadOnly="True" TextWrapping="Wrap" 
                                     Background="#0F172A" Foreground="#CBD5E1" BorderThickness="0" Padding="10" 
                                     FontFamily="Consolas" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Alt Bilgi -->
        <TextBlock Grid.Row="3" Text="Not: Analiz işlemleri arşivi diske çıkarmadan bellek üzerinden güvenli şekilde yürütülür." 
                   FontSize="11" Foreground="#64748B" Margin="0,12,0,0" HorizontalAlignment="Right"/>
    </Grid>
</Window>