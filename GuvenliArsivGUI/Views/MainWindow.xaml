<Window x:Class="GuvenliArsivGUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GuvenliArsivGUI.Converters"
        Title="Güvenli Arşiv Analizcisi" Height="760" Width="1220" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Üst Başlık ve Seçim / İptal Butonları -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Güvenli Arşiv Analizcisi" FontSize="22" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="Arşivleri diske çıkarmadan statik metadata, YARA ve tehdit istihbaratı analizi yapın"
                               FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📄 Arşiv Seç" Command="{Binding SelectFilesCommand}"
                            Style="{StaticResource ActionButtonStyle}" Background="#2563EB" Margin="0,0,8,0"/>
                    <Button Content="📁 Klasör Tara" Command="{Binding SelectFolderCommand}"
                            Style="{StaticResource ActionButtonStyle}" Background="#334155" Margin="0,0,8,0"/>
                    <Button Content="⏹ İptal Et" Command="{Binding CancelAnalysisCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource ActionButtonStyle}" Background="#DC2626"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Motor Ayarları Çubuğu (Motor Seçimi, Güvenli Mod & VirusTotal API Anahtarı) -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="⚙ Motor Seç" Command="{Binding SelectEngineCommand}"
                        Style="{StaticResource ActionButtonStyle}" Background="#475569" Padding="10,6" FontSize="12"
                        ToolTip="main.py veya paketlenmiş zipanalyzer.exe dosyasını seçin"/>

                <TextBlock Grid.Column="2" Text="{Binding ActiveEngineText}" Foreground="#38BDF8" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>

                <CheckBox Grid.Column="4" IsChecked="{Binding SafeMode}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"
                          Content="Güvenli Mod" Foreground="#E2E8F0" VerticalAlignment="Center"
                          ToolTip="Aktifken büyük veya şüpheli içerikler derin YARA/hash taramasına alınmaz."/>

                <TextBlock Grid.Column="6" Text="VT API Key:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="7" Text="{Binding VtApiKey, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"
                         Background="#0F172A" Foreground="#F8FAFC" CaretBrush="#38BDF8"
                         BorderBrush="#334155" BorderThickness="1" Padding="8,5" VerticalContentAlignment="Center"
                         ToolTip="İsteğe bağlı: Hash sorgulaması için ortam değişkeni (VT_API_KEY) olarak iletilir."/>

                <TextBlock Grid.Column="8" Text="Not: VT sorgusunda yalnızca SHA-256 özeti iletilir."
                           Foreground="#64748B" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- 3. Durum Çubuğu ve İlerleme Göstergesi -->
        <Border Grid.Row="2" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="8"
                Background="#162032" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#CBD5E1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Grid.Column="1" Width="170" Height="10" Margin="12,0,0,0"
                             IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                             Foreground="#38BDF8" Background="#0F172A"/>
            </Grid>
        </Border>

        <!-- 4. Ana İçerik: Sol Tablo & Sağ Rapor Detayları -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Sol Panel -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Analiz Sonuçları" FontSize="15" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="JSON Aktar" Command="{Binding ExportJsonCommand}"
                                    Style="{StaticResource ActionButtonStyle}" Background="#0F766E" Padding="10,5" FontSize="11" Margin="0,0,6,0"/>
                            <Button Content="CSV Aktar" Command="{Binding ExportCsvCommand}"
                                    Style="{StaticResource ActionButtonStyle}" Background="#0369A1" Padding="10,5" FontSize="11" Margin="0,0,6,0"/>
                            <Button Content="Temizle" Command="{Binding ClearReportsCommand}"
                                    Style="{StaticResource ActionButtonStyle}" Background="#475569" Padding="10,5" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              Background="#0F172A" Foreground="#F8FAFC" RowBackground="#1E293B"
                              AlternatingRowBackground="#172033" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#334155" BorderThickness="0" HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#273549"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Arşiv Adı" Binding="{Binding FileName}" Width="*" SortMemberPath="FileName"/>
                            <DataGridTemplateColumn Header="Risk" Width="96" SortMemberPath="RiskLevel">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#475569"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RiskLevel}" Value="HIGH">
                                                            <Setter Property="Background" Value="#DC2626"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RiskLevel}" Value="MEDIUM">
                                                            <Setter Property="Background" Value="#D97706"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RiskLevel}" Value="LOW">
                                                            <Setter Property="Background" Value="#16A34A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding RiskLevelTr}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Skor" Binding="{Binding RiskScore}" Width="50" SortMemberPath="RiskScore"/>
                            <DataGridTextColumn Header="Dosya" Binding="{Binding TotalFiles}" Width="55" SortMemberPath="TotalFiles"/>
                            <DataGridTextColumn Header="Oran" Binding="{Binding CompressionRatioDisplay}" Width="68" SortMemberPath="CompressionRatio"/>
                            <DataGridTextColumn Header="Süre" Binding="{Binding AnalysisTimeMs, StringFormat={}{0:F1} ms}" Width="72" SortMemberPath="AnalysisTimeMs"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Sağ Panel -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="10" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Arşiv Güvenlik Detayları" FontSize="15" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,12"/>
                        <TextBlock Text="Detayları görmek için soldaki tablodan bir arşiv seçin."
                                   Visibility="{Binding HasSelectedReport, Converter={StaticResource InverseBoolToVis}}"
                                   Foreground="#64748B" TextWrapping="Wrap"/>

                        <StackPanel Visibility="{Binding HasSelectedReport, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding DetailHeader}" FontSize="17" FontWeight="Bold" Foreground="#38BDF8" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DetailStats}" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,12" TextWrapping="Wrap"/>

                            <!-- Sunum İçin 4'lü Özet Metrik Kartları -->
                            <UniformGrid Columns="4" Margin="0,0,0,16">
                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="RİSK SKORU" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding SelectedScoreCard}" FontSize="15" FontWeight="Bold" Foreground="#F87171" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="ANALİZ SÜRESİ" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding SelectedTimeCard}" FontSize="15" FontWeight="Bold" Foreground="#34D399" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="SIKIŞTIRMA" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding SelectedRatioCard}" FontSize="15" FontWeight="Bold" Foreground="#FBBF24" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="İÇERİK SAYISI" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding SelectedFilesCard}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock Text="Tespit Edilen Uyarılar" FontWeight="SemiBold" Foreground="#F87171" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding SelectedWarnings}" Margin="0,0,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2D1B24" CornerRadius="5" Padding="8" Margin="0,0,0,5">
                                            <TextBlock Text="{Binding}" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Teknik Bulgular &amp; Tehdit İstihbaratı" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding TechnicalFindingsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     Background="#0F172A" Foreground="#CBD5E1" BorderThickness="0" Padding="10"
                                     FontFamily="Consolas" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 5. Alt Bilgi -->
        <TextBlock Grid.Row="4" Text="Not: Analiz işlemleri arşivi diske çıkarmadan bellek üzerinden güvenli şekilde yürütülür."
                   FontSize="11" Foreground="#64748B" Margin="0,10,0,0" HorizontalAlignment="Right"/>
    </Grid>
</Window>